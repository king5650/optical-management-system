class MedicalReportListPage(QMainWindow, Ui_MedicalReportList):
    def __init__(self, patient_id):
        super().__init__()
        self.setupUi(self)
        self.patient_id = patient_id

        # Connect buttons
        self.pushButton_add_report.clicked.connect(self.open_add_report_form)
        self.tableWidget.cellClicked.connect(self.open_report_detail)

        # Load medical reports
        self.load_medical_reports()

    def load_medical_reports(self):
        response = requests.get(f'http://127.0.0.1:8000/medical_reports/{self.patient_id}/')
        if response.status_code == 200:
            reports = response.json()['medical_reports']
            self.update_table(reports)
        else:
            QMessageBox.critical(self, "Error", "Failed to load medical reports.")

    def update_table(self, reports):
        self.tableWidget.setRowCount(0)
        for report in reports:
            row = self.tableWidget.rowCount()
            self.tableWidget.insertRow(row)
            self.tableWidget.setItem(row, 0, QTableWidgetItem(str(report['id'])))
            self.tableWidget.setItem(row, 1, QTableWidgetItem(report['date']))
            self.tableWidget.setItem(row, 2, QTableWidgetItem(report['patient']))

    def open_report_detail(self, row, column):
        report_id = self.tableWidget.item(row, 0).text()
        self.report_form = MedicalReportForm(report_id)
        self.report_form.show()
        self.close()

    def open_add_report_form(self):
        self.report_form = MedicalReportForm(patient_id=self.patient_id)
        self.report_form.show()
        self.close()

