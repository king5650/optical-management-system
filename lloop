        report_html += "<table border='1' cellspacing='0' cellpadding='5' width='100%'>"
        report_html += "<tr><th>Item Type</th><th>Category</th><th>Stock</th><th>Unit Price</th><th>Expiry Date</th></tr>"

        for row in range(self.inventory_table.rowCount()):
            item_type = self.inventory_table.item(row, 0).text()
            category = self.inventory_table.item(row, 1).text()
            stock = self.inventory_table.item(row, 2).text()
            unit_price = self.inventory_table.item(row, 3).text()
            expiry_date = self.inventory_table.item(row, 4).text()
            report_html += f"<tr><td>{item_type}</td><td>{category}</td><td>{stock}</td><td>{unit_price}</td><td>{expiry_date}</td></tr>"

        report_html += "</table>"

        # ✅ Load HTML into QTextDocument
        doc.setHtml(report_html)
        doc.setPageSize(page_rect.size())

        # ✅ Render document to painter
        doc.drawContents(painter)

        painter.end()  # Finish painting

