  <property name="styleSheet">
   <string notr="true">/* --- Define the &quot;Oceanic Professional&quot; Color Palette --- */
/* You can replace these variables with actual hex values in Qt Designer if preferred,
   or define them as custom properties if your Qt Designer version supports it.
   For direct copy-paste, it's often easier to just replace them. */

/* Primary Blue (Dark): A deep, rich navy/ocean blue – strong and trustworthy */
/* #0F4C81 */
/* Secondary Blue (Medium): A vibrant yet calm mid-tone blue – good for primary buttons, active states */
/* #3A8BD4 */
/* Accent Blue (Light): A soft, airy blue – for subtle highlights, backgrounds, inactive states */
/* #7FC8E8 */
/* Neutral (Light Gray): Clean and professional background/card color */
/* #E6EDF2 */
/* Neutral (Dark Gray/Text): Readable text, dark elements */
/* #34495E */
/* White Text: For text on dark backgrounds */
/* #FFFFFF */


/* --- MainWindow (or centralWidget if applying to background) --- */
/* Apply this to the MainWindow's stylesheet property */
QMainWindow {
    background-color: #E6EDF2; /* Neutral (Light Gray) */
}
/* If you prefer to apply to centralWidget, set its background */
QWidget#centralwidget {
    background-color: #E6EDF2; /* Neutral (Light Gray) */
}


/* --- header_part (QWidget) --- */
QWidget#header_part {
    background-color: #0F4C81; /* Primary Blue (Dark) */
    border-radius: 10px;
}

/* --- label (Title in Header) --- */
QLabel#label {
    color: #FFFFFF; /* White Text */
}


/* --- details (QWidget) and actionbuttons (QFrame) --- */
/* These frames are set to match the main window background for a seamless look */
QWidget#details,
QFrame#actionbuttons,
QFrame#frame_box {
    background-color: #E6EDF2; /* Neutral (Light Gray) */
    border: none; /* Ensure no default borders */
}


/* --- message_box (QTextEdit) --- */
QTextEdit#message_box {
    background-color: #FFFFFF; /* White Text */
    border: 1px solid #34495E; /* Neutral (Dark Gray) */
    border-radius: 5px;
    color: #34495E; /* Neutral (Dark Gray) */
    padding: 5px;
}


/* --- list_message_sent (QListView) --- */
QListView#list_message_sent {
    background-color: #FFFFFF; /* White Text */
    border: 1px solid #34495E; /* Neutral (Dark Gray) */
    border-radius: 5px;
    color: #34495E; /* Neutral (Dark Gray) */
}


/* --- send_message (QPushButton) &amp; cancel_message (QPushButton) &amp; search_btn (QPushButton) --- */
QPushButton {
    border: none;
    border-radius: 5px;
    background-color: #0F4C81; /* Primary Blue (Dark) */
    padding: 8px 15px;
    font-weight: bold;
    color: #FFFFFF; /* White Text */
}
QPushButton:hover {
    background-color: #3A8BD4; /* Secondary Blue (Medium) - Hover effect */
}


/* --- all_checkBox (QCheckBox) &amp; customize_checkBox (QCheckBox) --- */
QCheckBox {
    color: #34495E; /* Neutral (Dark Gray) */
}


/* --- dateTimeEdit (QDateTimeEdit) --- */
QDateTimeEdit#dateTimeEdit {
    background-color: #FFFFFF; /* White Text */
    border: 1px solid #34495E; /* Neutral (Dark Gray) */
    border-radius: 5px;
    color: #34495E; /* Neutral (Dark Gray) */
    padding: 5px;
}


/* --- group_name_input (QLineEdit) --- */
QLineEdit#group_name_input {
    background-color: #FFFFFF; /* White Text */
    border: 1px solid #34495E; /* Neutral (Dark Gray) */
    border-radius: 5px;
    color: #34495E; /* Neutral (Dark Gray) */
    padding: 5px;
}


/* --- group_dropdown (QComboBox) --- */
QComboBox#group_dropdown {
    background-color: #FFFFFF; /* White Text */
    border: 1px solid #34495E; /* Neutral (Dark Gray) */
    border-radius: 5px;
    color: #34495E; /* Neutral (Dark Gray) */
    padding: 5px;
}
QComboBox#group_dropdown::drop-down {
    border: 0px; /* Remove default arrow border */
}
/* You might need to add a custom arrow image if the default disappears or doesn't match */
/* QComboBox::down-arrow {
    image: url(:/icons/images/arrow_down_50px.png);
    width: 20px; height: 20px;
} */
QComboBox#group_dropdown:hover {
    border: 1px solid #3A8BD4; /* Secondary Blue (Medium) - Hover effect for border */
}
QComboBox#group_dropdown::on { /* Style when dropdown is open */
    border: 1px solid #3A8BD4; /* Secondary Blue (Medium) */
}
QComboBox#group_dropdown QAbstractItemView { /* Styles for the dropdown list itself */
    border: 1px solid #34495E; /* Neutral (Dark Gray) */
    border-radius: 5px;
    background-color: #FFFFFF; /* White Text */
    selection-background-color: #7FC8E8; /* Accent Blue (Light) */
    color: #34495E; /* Neutral (Dark Gray) */
}


/* --- search_bar (QLineEdit) --- */
QLineEdit#search_bar {
    border: 1px solid #34495E; /* Neutral (Dark Gray) */
    border-radius: 5px;
    color: #34495E; /* Neutral (Dark Gray) */
    padding: 9px;
    background-color: #FFFFFF; /* White Text */
    selection-background-color: #7FC8E8; /* Accent Blue (Light) */
}


/* --- tableWidget (QTableWidget) --- */
QTableWidget#tableWidget {
    background-color: #FFFFFF; /* White Text */
    border: 1px solid #34495E; /* Neutral (Dark Gray) */
    border-radius: 5px;
    gridline-color: #E6EDF2; /* Neutral (Light Gray) - Lighter grid lines */
    color: #34495E; /* Neutral (Dark Gray) */
}
QHeaderView::section { /* Style for table headers */
    background-color: #0F4C81; /* Primary Blue (Dark) */
    color: #FFFFFF; /* White Text */
    padding: 5px;
    border: 1px solid #E6EDF2; /* Neutral (Light Gray) */
    border-bottom: 2px solid #3A8BD4; /* Secondary Blue (Medium) - Accent line */
}
QTableWidget::item {
    padding: 5px;
}
QTableWidget::item:selected {
    background-color: #7FC8E8; /* Accent Blue (Light) - Selected item background */
    color: #34495E; /* Neutral (Dark Gray) */
}


/* --- progressBar (QProgressBar) --- */
QProgressBar#progressBar {
    border: 2px solid #0F4C81; /* Primary Blue (Dark) */
    border-radius: 10px;
    background-color: #E6EDF2; /* Neutral (Light Gray) */
    text-align: center;
    color: #34495E; /* Neutral (Dark Gray) */
    font-weight: bold;
    padding: 2px;
    /* Transitions are not directly supported in QSS for Qt Designer preview,
       but they will work at runtime if applied programmatically or via a compiled stylesheet. */
    /* transition: all 0.3s ease-in-out; */
}
QProgressBar#progressBar:hover {
    border: 2px solid #3A8BD4; /* Secondary Blue (Medium) */
    background-color: #E6EDF2; /* Keep background consistent on hover */
}
QProgressBar#progressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3A8BD4, stop:1 #0F4C81); /* Gradient for the chunk */
    border-radius: 8px;
    /* transition: background-color 0.3s ease-in-out; */
}


/* --- statusLabel (QLabel) --- */
QLabel#statusLabel {
    background-color: #0F4C81; /* Primary Blue (Dark) */
    color: #FFFFFF; /* White Text */
    border-radius: 5px;
    padding: 5px;
    font-weight: bold;
}</string>
