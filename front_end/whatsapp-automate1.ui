           <property name="styleSheet">
            <string notr="true">QProgressBar {
    border: 2px solid #3498db; /* Border color */
    border-radius: 10px; /* Rounded corners for the main bar */
    background-color: #ecf0f1; /* Background color of the empty part */
    text-align: center; /* Center the percentage text */
    color: #2c3e50; /* Color of the percentage text */
    font-weight: bold; /* Make the text bold */
    padding: 2px; /* Padding inside the progress bar */
   /* transition: all 0.3s ease-in-out;  Smooth transition for hover effects */
}

QProgressBar:hover {
    border: 2px solid #2980b9; /* Darker border on hover */
    background-color: #e0e0e0; /* Slightly darker background on hover */
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1abc9c, stop:1 #16a085); /* Gradient for the chunk */
    border-radius: 8px; /* Rounded corners for the chunk (slightly smaller than main bar) */
     /*transition: background-color 0.3s ease-in-out; Smooth transition for chunk color */
}

/* Optional: Different chunk color on hover (if you want the chunk to change on hover of the *chunk* itself, which is less common for progress bars) */
QProgressBar::chunk:hover {
    /* This might not be noticeable as the chunk's size changes dynamically. */
    /* Consider if this truly adds value to the UX of a progress bar. */
    /* background-color: #27ae60; */
}</string>
