  <property name="styleSheet">
   <string notr="true">/*= Style for mainwindow START
  ==================================================== */
	#MainWindow {
		background-color: #fff; /*3A4250*/
	}
QMenuBar {
    background-color: rgb(49, 58, 70); /* Dark background */
    padding: 5px 10px; /* Adjust padding for better spacing */
    color: rgb(230, 230, 230); /* Slightly softer white for text */
    font: 575 9pt &quot;Segoe UI&quot;; /* Use a slightly lighter weight for better readability */
    border-bottom: 1px solid rgb(60, 70, 85); /* Subtle bottom border for separation */
}

QMenuBar::item {
    background: transparent; /* Make menu bar items transparent by default */
    padding: 5px 15px;
    margin: 2px 5px; /* Add some margin around items */
    border-radius: 4px; /* Slightly rounded corners for items */
}

QMenuBar::item:selected {
    background-color: rgba(58, 139, 212, 50); /* Secondary Blue (Medium) with slight transparency on selection */
}

QMenuBar::item:pressed {
    background-color: rgba(15, 76, 129, 80); /* Dark Blue with slight transparency on press */
}

QMenu {
    background-color: rgb(245, 245, 245); /* Light background for the menu */
    border: 1px solid rgb(200, 200, 200);
    margin: 2px; /* Small margin around the menu */
    border-radius: 4px;
}

QMenu::item {
    background: transparent;
    padding: 8px 25px;
    color: rgb(50, 50, 50);
}

QMenu::item:selected {
    background-color: rgba(58, 139, 212, 30); /* Light highlight on selection */
}

QMenu::item:disabled {
    color: rgb(150, 150, 150);
}

QMenu::separator {
    height: 1px;
    background: rgb(220, 220, 220);
    margin: 5px 0;
}

QMenu::indicator {
    width: 13px;
    height: 13px;
}

QMenu::icon {
    margin-right: 8px;
}
  /*QMenuBar{	
	background-color: rgb(49, 58, 70);
	padding: 10px;
	color: rgb(255, 255, 255);
	font: 700 9pt &quot;Segoe UI&quot;;
}

QMenu:hover {
    border: 2px solid #3A8BD4; /* Secondary Blue (Medium) *
    background-color: #E6EDF2; /* Keep background consistent on hover *
}
QMenu::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3A8BD4, stop:1 #0F4C81); /* Gradient for the chunk
    border-radius: 8px;
   transition: background-color 0.3s ease-in-out; 
}
*/
/*= END


  ==================================================== */

/*= Style for button to change menu style START
  ==================================================== */
	#change_btn {
		padding: 5px;
		border: none;
		width: 30px;
		height: 30px;
	}
/*= END
  ==================================================== */

/*= Style for header widget START
  ==================================================== */
	#widget {
		background-color: #f9fafd;
	}
/*= END
  ==================================================== */

/*= Style for menu with icon only START
  ==================================================== */
  	/* style for widget */
	#icon_only_widget {
		background-color: #313a46;
		width:50px;
	}

    /* style for QPushButton and QLabel */
	#icon_only_widget QPushButton, QLabel {
		height:50px;
		border:none;
		/* border-bottom: 1px solid #b0b0b0; */
	}

	#icon_only_widget QPushButton:hover {
		background-color: rgba( 86, 101, 115, 0.5);
	}
	#icon_only_widget QPushButton:checked {
		color: #fff;		
		background-color: rgb(44, 47, 133);
		border-radius: 20px;
		width: 100%;
	
	}
	/* style for logo image */
	#logo_label_1 {
		padding: 5px
	}
/*= END
  ==================================================== */

/*= Style for menu with icon and text START
  ==================================================== */
	/* style for widget */
	#full_menu_widget {
		background-color: #313a46;
	}

	/* style for QPushButton */
	#full_menu_widget QPushButton {
		border:none;
		border-radius: 3px;
		text-align: left;
		padding: 8px 0 8px 15px;
		color: #788596;
	}

	#full_menu_widget QPushButton:hover {
		background-color: rgba( 86, 101, 115, 0.5);
	}

	#full_menu_widget QPushButton:checked {
		color: #fff;
		border-radius: 10px;
	background-color: rgb(44, 47, 133);
	width: 1200;
	}

	/* style for logo image */
	#logo_label_2 {
		padding: 5px;
		color: #fff;
	}

	/* style for APP title */
	#logo_label_3 {
		padding-right: 10px;
		color: #fff;
	}
/*= END
  ==================================================== */

/*= Style for search button START
  ==================================================== */
	#search_btn {
		border: none;
	}
/*= END
  ==================================================== */

/*= Style for search input START
  ==================================================== */
	#search_input {
		border: none;
		padding: 5px 10px;
	}

	#search_input:focus {
		background-color: #70B9FE;
	}
/*= END
  ==================================================== */

/*= Style for user information button START
  ==================================================== */
	#user_btn {
		border: none;
	}

/*= END
  ==================================================== */</string>
